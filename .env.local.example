# Copy this file to .env.local and fill in your Supabase project values.
# Find these in the Supabase dashboard → Project Settings → API.

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Never expose to the browser.
# Used by the seed script and by API route handlers.
SUPABASE_SERVICE_ROLE_KEY=
